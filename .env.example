# 前端配置
VITE_API_BASE_URL=/api

# 后端配置（Node 服务器，复制为 .env 填写实际值）
AI_API_KEY=your-api-key
AI_BASE_URL=https://api.anthropic.com
AI_PROVIDER=anthropic
AI_MODEL_ID=claude-sonnet-5
# 思考开关（仅对支持 thinking 字段的模型生效，如 GLM-5.2）：
#   disabled（默认）— 关闭思考，首字节 <1s，速度快；复杂布局规划可能略弱
#   enabled          — 开启思考，首字节约 +50s，布局/指令遵循更精细
AI_THINKING=disabled
PORT=8787
